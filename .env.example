# ===== Public (safe for browser bundle) =====
# Set these in your Vercel project env dashboard or .env.local.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Alt name (optional fallback):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===== Server-only — NEVER commit to git, NEVER expose to browser =====
# Set in Vercel env dashboard (Environment: Server) or .env.local.
SUPABASE_SECRET_KEY=your-service-role-secret-key
SUPABASE_URL=your-supabase-project-url

# ===== Security hardening =====
# Comma-separated list of allowed CORS origins (defaults to localhost + prod).
# CORS_ORIGINS=http://localhost:3000,https://mediflow.vercel.app

# ===== Super Admin bootstrap (scripts/setup-superadmin.mjs) =====
# Read from env or .env.local. NEVER hardcode in source.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=change-me-strong-password

# ===== E2E scripts =====
# These scripts also read SUPABASE_URL / SUPABASE_SECRET_KEY from env or .env.local.

# ===== Deployment =====
# Vercel Project: mediflow.vercel.app (git-connected: main -> auto deploy)
# Supabase: link via Vercel integration or set env above
# After push to GitHub main, Vercel builds `npm run build` and deploys to mediflow.vercel.app
# Verify: `npm run typecheck && npm run lint && npm run build && npm test` locally before push
